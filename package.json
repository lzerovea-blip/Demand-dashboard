{
  "name": "health-roadmap-studio",
  "version": "0.2.0",
  "private": true,
  "description": "离线运动健康需求汇总与路标 PPT 模板写入工具",
  "main": "dist-electron/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 file:dist-electron/main/index.js && electron .\"",
    "build": "tsc -p tsconfig.electron.json --noEmit && node scripts/build-electron.mjs && vite build",
    "test": "vitest run --config vitest.config.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && vitest run --config vitest.config.ts",
    "start": "electron .",
    "package:mac": "pnpm build && node scripts/package-mac.mjs",
    "package:win": "pnpm build && electron-builder --win --x64"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "image-size": "^1.2.1",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql.js": "^1.13.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  }
}
