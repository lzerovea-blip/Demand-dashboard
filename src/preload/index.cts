import { contextBridge, ipcRenderer, type IpcRendererEvent } from "electron";
import type {
  ElectronApi,
  HalfYearRange,
  SaveDictionaryInput,
  SaveGroupOrderInput,
  SaveGroupOverrideInput,
  SaveMemberInput,
  SavePptAccessPolicyInput,
  SaveRequirementInput,
  AppSnapshot,
  SaveTieringSupportInput,
  SaveTieringEvidenceSourceInput,
  UpdateTieringIssueInput,
  UpdateTieringChangeLogInput,
  RendererDiagnosticInput,
  LegacyRequirementDecision,
  WorkspaceImportMode,
  WorkspaceWorkbookConflictMode,
  WorkspaceWorkbookFieldSelection,
} from "../shared/types.js";

const api: ElectronApi = {
  getMcpDiagnostics: () => ipcRenderer.invoke("mcp:diagnostics"),
  copyMcpDiagnosticSummary: () => ipcRenderer.invoke("mcp:diagnostics:copy"),
  openMcpDiagnosticDirectory: () => ipcRenderer.invoke("mcp:diagnostics:open"),
  exportMcpDiagnostics: () => ipcRenderer.invoke("mcp:diagnostics:export"),
  runMcpSelfTest: () => ipcRenderer.invoke("mcp:self-test"),
  getMcpStatus: () => ipcRenderer.invoke("mcp:status"),
  getMcpLaunchConfiguration: () => ipcRenderer.invoke("mcp:launch-configuration"),
  copyMcpLaunchConfiguration: () => ipcRenderer.invoke("mcp:launch-configuration:copy"),
  setMcpEnabled: (enabled) => ipcRenderer.invoke("mcp:set-enabled", enabled),
  getMcpProposals: () => ipcRenderer.invoke("mcp:proposals:list"),
  decideMcpProposal: (id, accept) => ipcRenderer.invoke("mcp:proposals:decide", id, accept),
  onMcpChange: (listener) => { const subscription = () => listener(); ipcRenderer.on("mcp:changed", subscription); return () => ipcRenderer.removeListener("mcp:changed", subscription); },
  onSnapshotChange: (listener) => { const subscription = (_event: IpcRendererEvent, snapshot: AppSnapshot) => listener(snapshot); ipcRenderer.on("snapshot:changed", subscription); return () => ipcRenderer.removeListener("snapshot:changed", subscription); },
  saveRoadmap: (input) => ipcRenderer.invoke("roadmaps:save", input),
  deleteRoadmap: (id) => ipcRenderer.invoke("roadmaps:delete", id),
  saveRoadmapLane: (input) => ipcRenderer.invoke("roadmap-lanes:save", input),
  deleteRoadmapLane: (id) => ipcRenderer.invoke("roadmap-lanes:delete", id),
  saveRoadmapAssignments: (input) => ipcRenderer.invoke("roadmap-assignments:save", input),
  saveMedicalRoadmapPlan: (input) => ipcRenderer.invoke("medical-roadmap-plans:save", input),
  deleteMedicalRoadmapPlan: (input) => ipcRenderer.invoke("medical-roadmap-plans:delete", input),
  saveMedicalRoadmapPlanOrder: (input) => ipcRenderer.invoke("medical-roadmap-plans:reorder", input),
  getAppInfo: () => ipcRenderer.invoke("app:info"),
  getSnapshot: () => ipcRenderer.invoke("snapshot:get"),
  getWindowFullscreen: () => ipcRenderer.invoke("window:fullscreen:get"),
  setWindowFullscreen: (enabled: boolean) => ipcRenderer.invoke("window:fullscreen:set", enabled),
  onWindowFullscreenChange: (listener: (enabled: boolean) => void) => {
    const subscription = (_event: IpcRendererEvent, enabled: boolean) => listener(enabled);
    ipcRenderer.on("window:fullscreen:changed", subscription);
    return () => ipcRenderer.removeListener("window:fullscreen:changed", subscription);
  },
  saveRequirement: (input: SaveRequirementInput) => ipcRenderer.invoke("requirements:save", input),
  duplicateRequirement: (id: string) => ipcRenderer.invoke("requirements:duplicate", id),
  deleteRequirement: (id: string) => ipcRenderer.invoke("requirements:delete", id),
  saveDomain: (input: SaveDictionaryInput) => ipcRenderer.invoke("domains:save", input),
  deleteDomain: (id: string) => ipcRenderer.invoke("domains:delete", id),
  saveProduct: (input: SaveDictionaryInput) => ipcRenderer.invoke("products:save", input),
  deleteProduct: (id: string) => ipcRenderer.invoke("products:delete", id),
  saveMember: (input: SaveMemberInput) => ipcRenderer.invoke("members:save", input),
  deleteMember: (id: string) => ipcRenderer.invoke("members:delete", id),
  savePptAccessPolicy: (input: SavePptAccessPolicyInput) => ipcRenderer.invoke("ppt-access:save", input),
  checkIrmEnvironment: () => ipcRenderer.invoke("ppt-access:check-environment"),
  saveGroupOverride: (input: SaveGroupOverrideInput) => ipcRenderer.invoke("groups:save", input),
  saveGroupOrder: (input: SaveGroupOrderInput) => ipcRenderer.invoke("groups:reorder", input),
  saveMedicalRoadmapOrder: (input: { requirementIds: string[] }) => ipcRenderer.invoke("medical-roadmap:reorder", input),
  saveTieringSupport: (input: SaveTieringSupportInput) => ipcRenderer.invoke("tiering:support:save", input),
  saveTieringEvidenceSource: (input: SaveTieringEvidenceSourceInput) => ipcRenderer.invoke("tiering:source:save", input),
  updateTieringIssue: (input: UpdateTieringIssueInput) => ipcRenderer.invoke("tiering:issue:update", input),
  updateTieringChangeLog: (input: UpdateTieringChangeLogInput) => ipcRenderer.invoke("tiering:change-log:update", input),
  deleteTieringChangeLog: (logId: string) => ipcRenderer.invoke("tiering:change-log:delete", logId),
  regenerateTieringRequirement: (featureId: string) => ipcRenderer.invoke("tiering:requirement:regenerate", featureId),
  reportRendererDiagnostic: (input: RendererDiagnosticInput) => ipcRenderer.invoke("diagnostics:renderer-report", input),
  getDiagnosticInfo: () => ipcRenderer.invoke("diagnostics:info"),
  openDiagnosticDirectory: () => ipcRenderer.invoke("diagnostics:open-directory"),
  exportWorkspacePackage: () => ipcRenderer.invoke("workspace:export"),
  inspectWorkspacePackage: () => ipcRenderer.invoke("workspace:inspect"),
  applyWorkspacePackage: (input: { token: string; mode: WorkspaceImportMode; differenceDigest?: string; legacyRequirementDecisions?: Record<string, LegacyRequirementDecision> }) => ipcRenderer.invoke("workspace:apply", input),
  exportWorkspaceWorkbook: (input: HalfYearRange) => ipcRenderer.invoke("workbook:export", input),
  exportTieringWorkbook: (input: HalfYearRange) => ipcRenderer.invoke("tiering-workbook:export", input),
  inspectWorkspaceWorkbook: () => ipcRenderer.invoke("workbook:inspect"),
  applyWorkspaceWorkbook: (input: { token: string; conflictMode: WorkspaceWorkbookConflictMode; differenceDigest: string; fieldSelection?: WorkspaceWorkbookFieldSelection }) => ipcRenderer.invoke("workbook:apply", input),
  exportTemplateDraft: () => ipcRenderer.invoke("template:draft-export"),
  exportRoadmapPresentation: (input) => ipcRenderer.invoke("presentation:export", input),
};

contextBridge.exposeInMainWorld("roadmapApi", api);
